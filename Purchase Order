<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ใบสั่งซื้อ (Purchase Order) - บริษัท เค แอล สเตชั่นเนอรี่ จำกัด</title>
    <!-- Google Fonts: Sarabun & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0f766e;       /* ปรับโทนสีเป็น Teal เข้ม สุภาพสำหรับเอกสารจัดซื้อ */
            --primary-dark: #115e59;
            --primary-light: #ccfbf1;
            --secondary-color: #1e293b;
            --border-color: #cbd5e1;
            --bg-light: #f8fafc;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --shadow-subtle: 0 10px 30px -5px rgba(15, 118, 110, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            --radius-box: 16px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Sarabun', 'Inter', sans-serif;
            background: linear-gradient(135deg, #f6f8fb 0%, #eef2f7 100%);
            color: var(--secondary-color);
            margin: 0;
            padding: 30px 15px 60px 15px;
            font-size: 13px;
            line-height: 1.5;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        /* Toast Notification Styling */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast-notification {
            background: #ffffff;
            color: var(--secondary-color);
            padding: 12px 20px;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13px;
            font-weight: 600;
            border-left: 5px solid var(--success-color);
            animation: slideInRight 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), fadeOut 0.3s ease 2.7s forwards;
            max-width: 350px;
        }

        .toast-notification.error {
            border-left-color: var(--danger-color);
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(100%); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes fadeOut {
            to { opacity: 0; transform: translateY(-10px); }
        }

        /* Modern Sticky Toolbar */
        .modern-toolbar {
            position: sticky;
            top: 15px;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            margin: 10px auto 25px auto;
            max-width: 900px;
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 99px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
        }

        .toolbar-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            outline: none;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 3px 6px -1px rgba(0, 0, 0, 0.08);
        }

        .icon-btn svg {
            width: 20px;
            height: 20px;
        }

        .icon-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 8px 15px -2px rgba(0, 0, 0, 0.15);
        }

        .icon-btn::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -35px;
            left: 50%;
            transform: translateX(-50%) scale(0.8);
            opacity: 0;
            pointer-events: none;
            background: rgba(15, 23, 42, 0.85);
            color: #fff;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 8px;
            border-radius: 6px;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .icon-btn:hover::after {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }

        .btn-home { background: rgba(74, 20, 140, 0.85); color: #ffffff; }
        .btn-add { background: rgba(233, 30, 99, 0.85); color: #ffffff; }
        .btn-print { background: rgba(15, 118, 110, 0.9); color: #ffffff; }

        .btn-action {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 6px;
            padding: 4px 10px;
            font-family: inherit;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-action:hover { filter: brightness(1.1); }

        /* Container & Page Layout */
        .page-sheet {
            max-width: 900px;
            margin: 0 auto 35px auto;
            background: #ffffff;
            padding: 40px;
            box-shadow: var(--shadow-subtle);
            border-radius: var(--radius-box);
            position: relative;
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        /* Header Section */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 18px;
            margin-bottom: 18px;
        }

        .header-left {
            display: flex;
            gap: 18px;
            align-items: flex-start;
        }

        .logo-container img {
            width: 75px;
            height: auto;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .shop-info-box .company-name {
            font-weight: 700;
            font-size: 16px;
            color: var(--primary-dark);
            margin-bottom: 4px;
        }

        .shop-info-box .address-text {
            color: #64748b;
            font-size: 11px;
            line-height: 1.5;
        }

        .title-box {
            text-align: right;
        }

        .title-main {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary-color);
            letter-spacing: 0.5px;
            line-height: 1.2;
        }

        .title-sub {
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 2px;
        }

        /* Top Info Grid */
        .top-info {
            width: 100%;
            margin-bottom: 18px;
            border-collapse: collapse;
        }

        .top-info td {
            vertical-align: top;
            padding: 4px;
        }

        .top-info td:first-child { width: 58%; }
        .top-info td:last-child { width: 42%; }

        .vendor-info-box {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 10px 12px;
            border-radius: 12px;
        }

        .po-meta-box {
            background-color: var(--primary-light);
            border: 1px solid #99f6e4;
            padding: 12px 14px;
            border-radius: 12px;
        }

        .info-row {
            margin-bottom: 5px;
            display: flex;
            align-items: baseline;
        }
        .info-row:last-child { margin-bottom: 0; }

        .info-label {
            font-weight: 600;
            color: #475569;
            min-width: 115px;
            font-size: 11.5px;
        }

        .inline-input {
            border: none;
            border-bottom: 1.5px dashed var(--border-color);
            outline: none;
            font-family: inherit;
            font-size: inherit;
            padding: 2px 6px;
            color: var(--secondary-color);
            background: transparent;
            transition: all 0.25s ease;
        }

        .inline-input:focus {
            border-bottom: 1.5px solid var(--primary-color);
            background-color: #fff;
            border-radius: 4px;
        }

        .inline-textarea {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            outline: none;
            font-family: inherit;
            font-size: inherit;
            padding: 3px 6px;
            resize: none;
            width: 100%;
            background: #fff;
            min-height: 26px;
            height: auto;
            overflow-y: hidden;
            word-break: break-word !important;
            overflow-wrap: break-word !important;
            white-space: pre-wrap !important;
        }

        /* Delivery Box (สถานที่จัดส่งสำหรับใบสั่งซื้อ) */
        .delivery-box {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            margin-bottom: 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        /* Table Styling */
        .table-responsive-wrapper {
            margin-bottom: 15px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

        .data-table th, .data-table td {
            border: 1px solid var(--border-color);
            padding: 8px 10px;
            vertical-align: middle !important;
        }

        .data-table th {
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
            color: #334155;
            text-align: center;
            font-weight: 700;
            font-size: 12px;
        }

        .item-desc {
            display: block;
            width: 100%;
            min-height: 22px;
            height: 22px;
            box-sizing: border-box;
            border: none;
            outline: none;
            resize: none;
            margin: 0;
            padding: 0;
            font-family: inherit;
            font-size: inherit;
            line-height: 1.4;
            background: transparent;
            overflow: hidden;
            white-space: pre-wrap !important;
            overflow-wrap: anywhere !important;
        }

        .sku-input, .qty, .price, .unit-input {
            width: 100%;
            border: none;
            outline: none;
            font-family: inherit;
            font-size: inherit;
            background: transparent;
        }

        .qty, .price { text-align: right !important; }
        .sku-input, .unit-input { text-align: center !important; }

        .btn-del {
            background-color: #fee2e2;
            color: var(--danger-color);
            border: none;
            padding: 4px 8px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-del:hover {
            background-color: var(--danger-color);
            color: white;
        }

        /* Footer & Summary Table */
        .footer-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .footer-table td {
            border: 1px solid var(--border-color);
            padding: 7px 12px;
            font-size: 12px;
        }

        .footer-total-label {
            background-color: var(--bg-light);
            font-weight: 600;
            color: #475569;
            width: 25%;
            white-space: nowrap;
        }

        /* Signature Section (3 ช่องสำหรับใบสั่งซื้อ: ผู้จัดทำ / ผู้ตรวจสอบ / ผู้อนุมัติสั่งซื้อ) */
        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 15px;
            page-break-inside: avoid;
        }

        .sig-box {
            flex: 1;
            text-align: center;
            border: 1px solid var(--border-color);
            padding: 14px 10px;
            border-radius: 12px;
            background-color: #f8fafc;
        }

        .sig-line {
            border-bottom: 1.5px dotted #94a3b8;
            margin: 32px 12px 8px 12px;
        }

        .sig-name-input {
            border: none;
            border-bottom: 1.5px dashed var(--border-color);
            text-align: center;
            width: 90%;
            outline: none;
            font-family: inherit;
            margin-bottom: 4px;
            font-size: 12px;
            background: transparent;
        }

        .sig-text {
            font-size: 11.5px;
            color: #334155;
            font-weight: 700;
        }

        .sig-date {
            font-size: 11px;
            color: #64748b;
            margin-top: 4px;
        }

        .sig-date-input {
            border: none;
            border-bottom: 1.5px dashed var(--border-color);
            text-align: center;
            width: 95px;
            outline: none;
            font-family: inherit;
            background: transparent;
        }

        #print-pages-container {
            display: flex;
            flex-direction: column;
            gap: 35px;
        }

        /* Print Settings */
        @media print {
            @page {
                size: A4;
                margin: 5mm;
            }
            body {
                background-color: #ffffff;
                padding: 0;
                font-size: 11px;
                line-height: 1.3;
            }
            .modern-toolbar, .no-print, #toast-container {
                display: none !important;
            }
            .page-sheet {
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 auto !important;
                padding: 8px 14px !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                border: none !important;
                page-break-after: always;
            }
            .header-section {
                padding-bottom: 4px;
                margin-bottom: 6px;
            }
            .logo-container img { width: 55px !important; }
            .shop-info-box .company-name { font-size: 13px; }
            .shop-info-box .address-text { font-size: 10px; }
            .title-main { font-size: 18px; }
            .top-info { margin-bottom: 6px; }
            .vendor-info-box, .po-meta-box { padding: 6px 8px !important; border-radius: 8px; }
            .delivery-box { padding: 5px 8px !important; margin-bottom: 6px; border-radius: 6px; }
            .info-row { margin-bottom: 3px; }
            .inline-textarea {
                border: none !important;
                padding: 1px 4px !important;
                height: auto !important;
            }
            .data-table th, .data-table td {
                padding: 2px 5px !important;
                font-size: 11px;
            }
            .footer-table { margin-bottom: 6px; }
            .footer-table td { padding: 2px 6px !important; font-size: 11px; }
            .signature-section { margin-top: 8px !important; gap: 10px; }
            .sig-box { padding: 6px 6px !important; border-radius: 8px; }
            .sig-line { margin: 22px 8px 4px 8px !important; }
            .sig-name-input, .sig-date-input { border: none !important; }
            input::placeholder, textarea::placeholder {
                color: transparent !important;
                -webkit-text-fill-color: transparent !important;
            }
        }
    </style>
</head>
<body>

<div id="toast-container"></div>

<!-- แถบเครื่องมือด้านบน -->
<div class="modern-toolbar no-print">
  <div class="toolbar-group">
    <a href="index.html" class="icon-btn btn-home" data-tooltip="หน้าแรก">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
    </a>
  </div>
  
  <div class="toolbar-group">
    <button class="icon-btn btn-add" onclick="addRow()" data-tooltip="เพิ่มรายการสั่งซื้อ">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    </button>
    
    <button class="icon-btn btn-print" onclick="window.print()" data-tooltip="พิมพ์ / บันทึก PDF">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-19.163 0C1.837 7.441 1 8.375 1 9.456v6.294A2.25 2.25 0 003.25 18h1.091m16.5 0v-6.75A2.25 2.25 0 0018.591 9H5.409A2.25 2.25 0 003.15 11.25V18" />
      </svg>
    </button>
  </div>
</div>

<!-- พื้นที่แสดงหน้าเอกสาร -->
<div id="print-pages-container"></div>

<script>
    function showToast(message, isError = false) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast-notification ${isError ? 'error' : ''}`;
        toast.innerHTML = `
            <span style="font-size: 16px;">${isError ? '❌' : '✅'}</span>
            <span>${message}</span>
        `;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    const urlParams = new URLSearchParams(window.location.search);
    const today = new Date();
    const day = String(today.getDate()).padStart(2, '0');
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const yearAD = today.getFullYear();
    const yearBE = yearAD + 543;
    const currentDateFormatted = `${day}/${month}/${yearBE}`;

    const autoPoNo = urlParams.get('poNo') || `PO${yearAD}${month}001`;

    // ข้อมูลหลักของใบสั่งซื้อ (Purchase Order)
    let docMeta = {
        vendorName: "",
        vendorAddress: "",
        vendorTaxNo: "",
        vendorContact: "",
        vendorTel: "",
        poNo: autoPoNo,
        poDate: currentDateFormatted,
        refQuotationNo: urlParams.get('refQuotationNo') || "-",
        creditTerm: "เครดิต 30 วัน",
        deliveryDate: "-",
        deliveryAddress: "บริษัท เค แอล สเตชั่นเนอรี่ จำกัด 873, 875 ถนนสุขุมวิท 105 แขวงบางนาใต้ เขตบางนา กรุงเทพมหานคร 10260",
        remarkText: "1. กรุณาระบุเลขที่ใบสั่งซื้อ (PO No.) ในใบส่งของและใบกำกับภาษีทุกครั้ง\n2. การส่งมอบสินค้าถือว่าสมบูรณ์เมื่อผ่านการตรวจรับจากแผนกคลังสินค้าเรียบร้อยแล้ว",
        discountRate: 0,
        vatType: "exclude", // 'exclude' = แยก VAT 7%, 'none' = ไม่มี VAT
        sigPreparedName: "",
        sigPreparedDate: currentDateFormatted,
        sigCheckedName: "",
        sigCheckedDate: "",
        sigApprovedName: "",
        sigApprovedDate: ""
    };

    let itemsData = [
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 },
        { desc: "", model: "", qty: 1, unit: "", price: 0.00 }
    ];

    const ITEMS_PER_PAGE = 14;

    function renderDocument() {
        const container = document.getElementById("print-pages-container");
        container.innerHTML = "";

        const totalPages = Math.ceil(itemsData.length / ITEMS_PER_PAGE) || 1;

        for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
            const startIdx = pageIdx * ITEMS_PER_PAGE;
            const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, itemsData.length);
            const pageItems = itemsData.slice(startIdx, endIdx);
            const isLastPage = (pageIdx === totalPages - 1);

            const pageDiv = document.createElement("div");
            pageDiv.className = "page-sheet";
            pageDiv.setAttribute("data-page-index", pageIdx);
            pageDiv.setAttribute("data-is-last", isLastPage ? "true" : "false");

            let pageHTML = `
                <!-- ส่วนหัวบริษัทผู้สั่งซื้อ -->
                <div class="header-section">
                    <div class="header-left">
                        <div class="logo-container">
                            <img src="logo.png" alt="KL Logo" onerror="this.style.display='none'">
                        </div>
                        <div class="shop-info-box">
                            <div class="company-name">บริษัท เค แอล สเตชั่นเนอรี่ จำกัด (สำนักงานใหญ่)</div>
                            <div class="address-text">873, 875 ถนนสุขุมวิท 105 แขวงบางนาใต้ เขตบางนา กรุงเทพมหานคร 10260</div>
                            <div class="address-text">โทร. 0-2748-6788 | เลขประจำตัวผู้เสียภาษี: 0105544005337</div>
                        </div>
                    </div>
                    <div class="title-box">
                        <div class="title-main">ใบสั่งซื้อ</div>
                        <div class="title-sub">PURCHASE ORDER</div>
                        <div style="font-size: 11px; color: #64748b; margin-top: 4px; font-weight: 600;">หน้าที่ ${pageIdx + 1} / ${totalPages}</div>
                    </div>
                </div>

