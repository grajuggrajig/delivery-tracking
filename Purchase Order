    function updateMeta(field, value) {
        docMeta[field] = value;
    }

    function updateItemData(index, field, value) {
        itemsData[index][field] = value;
        if (field === 'qty' || field === 'price') {
            calculateTotals();
        }
    }

    function addRow() {
        itemsData.push({ desc: "", model: "", qty: 1, unit: "", price: 0.00 });
        renderDocument();
    }

    function removeRow(index) {
        itemsData.splice(index, 1);
        renderDocument();
    }

    // ฟังก์ชันคำนวณยอดเงินทั้งหมดตามรูปแบบต้นฉบับ
    function calculateTotals() {
        let subTotal = 0;

        itemsData.forEach((item) => {
            const qty = parseFloat(String(item.qty).replace(/,/g, '')) || 0;
            const price = parseFloat(String(item.price).replace(/,/g, '')) || 0;
            subTotal += (qty * price);
        });

        let discountRate = parseFloat(docMeta.discountRate);
        let discountAmount = 0;

        if (isNaN(discountRate) || discountRate <= 0) {
            discountRate = 0;
            discountAmount = 0;
        } else {
            discountAmount = (subTotal * discountRate) / 100;
        }

        let netTotal = subTotal - discountAmount;
        if (netTotal < 0) netTotal = 0;

        let vatAmount = (docMeta.vatType === 'none') ? 0 : (netTotal * 0.07);
        let grandTotal = netTotal + vatAmount;
        let thaiTextStr = arabicToThaiText(grandTotal);

        const pageSheets = document.querySelectorAll(".page-sheet");
        const totalPages = pageSheets.length;

        pageSheets.forEach((sheet) => {
            const isLast = sheet.getAttribute("data-is-last") === "true";

            const displaySubTotal = (totalPages === 1 || isLast) ? subTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
            const displayDiscount = (totalPages === 1 || isLast) ? discountAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
            const displayNetTotal = (totalPages === 1 || isLast) ? netTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
            const displayVat      = (totalPages === 1 || isLast) ? vatAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
            const displayGrand    = (totalPages === 1 || isLast) ? grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
            const displayThaiText = (totalPages === 1 || isLast) ? thaiTextStr : "ศูนย์บาทถ้วน";

            const subTotalEl = sheet.querySelector(".subTotal");
            const discountRateEl = sheet.querySelector(".discountRate");
            const discountAmountEl = sheet.querySelector(".discountAmount");
            const netTotalEl = sheet.querySelector(".netTotal");
            const vatAmountEl = sheet.querySelector(".vatAmount");
            const grandTotalEl = sheet.querySelector(".grandTotal");
            const textAmountEl = sheet.querySelector(".textAmount");

            if (subTotalEl) subTotalEl.textContent = displaySubTotal;
            if (discountRateEl) discountRateEl.value = discountRate;
            if (discountAmountEl) discountAmountEl.value = displayDiscount;
            if (netTotalEl) netTotalEl.textContent = displayNetTotal;
            if (vatAmountEl) vatAmountEl.textContent = displayVat;
            if (grandTotalEl) grandTotalEl.textContent = displayGrand;
            if (textAmountEl) textAmountEl.textContent = displayThaiText;
        });

        // อัปเดตยอดรวมรายบรรทัด
        document.querySelectorAll(".item-row").forEach((row) => {
            const idx = parseInt(row.getAttribute("data-item-index"), 10);
            if (!isNaN(idx) && itemsData[idx]) {
                const q = parseFloat(String(itemsData[idx].qty).replace(/,/g, '')) || 0;
                const p = parseFloat(String(itemsData[idx].price).replace(/,/g, '')) || 0;
                const amtCell = row.querySelector(".amount");
                if (amtCell) {
                    amtCell.textContent = (q * p).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            }
        });
    }

    // แปลงตัวเลขเป็นคำอ่านภาษาไทย (รองรับหลักล้านขึ้นไป)
    function arabicToThaiText(amount) {
        if (!amount || amount === 0) return "ศูนย์บาทถ้วน";
        const arabicNumber = amount.toFixed(2);
        const splitNum = arabicNumber.split(".");
        let integerPart = splitNum[0];
        let decimalPart = splitNum[1];

        let thaiText = convertIntegerToThai(integerPart) + "บาท";
        if (decimalPart === "00") {
            thaiText += "ถ้วน";
        } else {
            thaiText += convertIntegerToThai(decimalPart) + "สตางค์";
        }
        return thaiText;
    }

    function convertIntegerToThai(numStr) {
        const thaiNums = ["ศูนย์", "หนึ่ง", "สอง", "สาม", "สี่", "ห้า", "หก", "เจ็ด", "แปด", "เก้า"];
        const thaiUnits = ["", "สิบ", "ร้อย", "พัน", "หมื่น", "แสน", "ล้าน"];
        let result = "";
        let len = numStr.length;

        for (let i = 0; i < len; i++) {
            let digit = parseInt(numStr[i], 10);
            let pos = len - i - 1;
            let unitIndex = pos % 6;

            if (digit !== 0) {
                if (unitIndex === 1 && digit === 1) {
                    result += "สิบ";
                } else if (unitIndex === 1 && digit === 2) {
                    result += "ยี่สิบ";
                } else if (unitIndex === 0 && digit === 1 && len > 1 && parseInt(numStr[len - 2], 10) !== 0) {
                    result += "เอ็ด";
                } else {
                    result += thaiNums[digit] + thaiUnits[unitIndex];
                }
            }
            if (pos > 0 && unitIndex === 0) {
                result += "ล้าน";
            }
        }
        return result;
    }

    // โหลดรายชื่อผู้ขาย (Vendor) จาก localStorage (ถ้ามีเก็บไว้ในระบบ)
    let allVendorsData = [];
    function loadVendorDropdown() {
        const localVendors = JSON.parse(localStorage.getItem('saved_po_vendors') || localStorage.getItem('saved_quot_customers') || '[]');
        allVendorsData = localVendors;
        document.querySelectorAll('.vendorSelect').forEach(select => {
            select.innerHTML = '<option value="">-- เลือกผู้ขาย / ซัพพลายเออร์ --</option>';
            localVendors.forEach(v => {
                const name = typeof v === 'string' ? v : (v.name || v.vendorName || v.companyName || '');
                if (name) {
                    const opt = document.createElement('option');
                    opt.value = name;
                    opt.textContent = name;
                    select.appendChild(opt);
                }
            });
        });
    }

    function selectVendor(selectEl) {
        const selectedName = selectEl.value;
        const found = allVendorsData.find(v => {
            const name = typeof v === 'string' ? v : (v.name || v.vendorName || v.companyName || '');
            return name === selectedName;
        });

        if (found && typeof found === 'object') {
            docMeta.vendorName = found.name || found.vendorName || found.companyName || selectedName;
            docMeta.vendorAddress = found.address || found.vendorAddress || '';
            docMeta.vendorTaxNo = found.taxNo || found.tax || '';
            docMeta.vendorContact = found.contact || '';
            docMeta.vendorTel = found.tel || found.phone || '';
        } else {
            docMeta.vendorName = selectedName;
        }
        renderDocument();
    }

    // ดึงรายการสินค้าจากเลขที่ใบเสนอราคา (Quotation) ใน localStorage มาออกใบสั่งซื้อ
    function importFromQuotation(btnEl) {
        const box = btnEl.closest('.po-meta-box');
        const qNo = (box?.querySelector('.searchQuotationInput')?.value || '').trim();
        if (!qNo) {
            showToast("กรุณากรอกเลขที่ใบเสนอราคาที่ต้องการดึงข้อมูล", true);
            return;
        }

        let savedBills = [];
        try { savedBills = savedBills.concat(JSON.parse(localStorage.getItem('saved_quotations') || '[]')); } catch(e){}
        try { savedBills = savedBills.concat(JSON.parse(localStorage.getItem('saved_quot_purchases') || '[]')); } catch(e){}

        const found = savedBills.find(b => String(b.billNo || b.quotationNo || '').trim() === qNo);
        if (found) {
            docMeta.refQuotationNo = qNo;
            docMeta.discountRate = found.discountRate || found.discount || 0;
            const rawItems = found.items || found.itemsData || [];
            if (rawItems.length > 0) {
                itemsData = rawItems.map(item => ({
                    desc: item.desc || item.name || "",
                    model: item.model || "",
                    qty: Number(item.qty) || 1,
                    unit: item.unit || "",
                    price: Number(item.price || item.unitPrice) || 0
                }));
            }
            renderDocument();
            showToast(`นำเข้ารายการจากใบเสนอราคา ${qNo} เรียบร้อยแล้ว`);
        } else {
            showToast(`ไม่พบข้อมูลใบเสนอราคาเลขที่ ${qNo}`, true);
        }
    }

    // ปรับความสูง Textarea อัตโนมัติ
    function adjustTextareaHeight(ta) {
        if (!ta) return;
        ta.style.height = '22px';
        ta.style.height = Math.max(22, ta.scrollHeight) + 'px';
    }

    function adjustAllTextareas() {
        requestAnimationFrame(() => {
            document.querySelectorAll('textarea.item-desc, textarea.inline-textarea').forEach(adjustTextareaHeight);
        });
    }

    document.addEventListener('input', function(e) {
        if (e.target && e.target.matches('textarea')) {
            adjustTextareaHeight(e.target);
        }
    });

    window.addEventListener('resize', adjustAllTextareas);
    window.addEventListener('beforeprint', adjustAllTextareas);

    window.onload = function() {
        renderDocument();
    };
</script>

</body>
</html>
